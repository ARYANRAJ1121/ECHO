      "name": "Format: Simulation Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [560, 800]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "channel",
              "name": "channel",
              "value": "#echo-reports",
              "type": "string"
            },
            {
              "id": "notification",
              "name": "notification",
              "value": "={{ $json.summary }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-summary",
      "name": "Send Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [820, 800],
      "notesInFlow": true,
      "notes": "Connect Slack/Discord/Email/Sheets here for automated reporting"
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst lambda = Number(j.lambda || 0);\nconst mode = j.mode || 'unknown';\nconst round = Number(j.round || 0);\n\nlet risk_level = 'LOW';\nlet recommendation = 'Continue monitoring';\nif (lambda >= 0.7) {\n  risk_level = 'CRITICAL';\n  recommendation = 'Trigger demand shock test for causal verification';\n} else if (lambda >= 0.5) {\n  risk_level = 'ELEVATED';\n  recommendation = 'Increase monitoring frequency';\n} else if (lambda >= 0.3) {\n  risk_level = 'MODERATE';\n  recommendation = 'Watch for upward trends';\n}\n\nreturn [{ json: {\n  score_card: {\n    round,\n    mode,\n    lambda,\n    risk_level,\n    recommendation,\n    timestamp: new Date().toISOString()\n  }\n}}];"
      },
      "id": "score-card",
      "name": "Collusion Score Card",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 400]
    }
  ],
