      "typeVersion": 3.4,
      "position": [1020, 200],
      "notesInFlow": true,
      "notes": "Connect Slack, Discord, or Email here for live alerts"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "report_type",
              "name": "report_type",
              "value": "simulation_complete",
              "type": "string"
            },
            {
              "id": "summary",
              "name": "summary",
              "value": "=ECHO Simulation Report\nMode: {{ $json.mode }}\nDataset: {{ $json.dataset }}\nRounds: {{ $json.total_rounds }}\nMean Lambda: {{ $json.regulator.mean_lambda }}\nPeak Lambda: {{ $json.regulator.peak_lambda }}\nTotal Alerts: {{ $json.regulator.total_alerts }}\nTrend: {{ $json.regulator.trend }}",
              "type": "string"
            },
