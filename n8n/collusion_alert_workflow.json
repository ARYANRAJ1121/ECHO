            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "🟢 Log: Watch Level",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🔴 Format: Critical Alert": {
      "main": [
        [
          {
            "node": "📢 Send Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "📢 Send Notification": {
      "main": [
        [
          {
            "node": "🎯 Collusion Score Card",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🟡 Format: Warning": {
      "main": [
        [
          {
            "node": "🎯 Collusion Score Card",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🟢 Log: Watch Level": {
      "main": [
        [
          {
            "node": "🎯 Collusion Score Card",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "✅ Webhook: Simulation Complete": {
      "main": [
        [
          {
            "node": "📊 Format: Simulation Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "📊 Format: Simulation Report": {
      "main": [
        [
          {
            "node": "📤 Send Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "ECHO"
    }
  ],
