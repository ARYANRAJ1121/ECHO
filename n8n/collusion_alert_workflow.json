{
  "name": "ECHO Collusion Alert Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "echo-alert",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "webhook-alert",
      "name": "Webhook: Collusion Alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [200, 400],
      "webhookId": "echo-alert"
    },
    {
      "parameters": {
        "jsCode": "// Newer n8n webhook nodes nest the POST JSON under .body.\n// Flatten so the rest of the pipeline can use $json.lambda, etc.\nconst raw = $input.first().json;\nconst data = (raw && raw.body && typeof raw.body === 'object') ? raw.body : raw;\nreturn [{ json: {\n  event: data.event || 'collusion_alert',\n  round: Number(data.round ?? 0),\n  lambda: Number(data.lambda ?? 0),\n  avg_price: Number(data.avg_price ?? 0),\n  mode: data.mode || 'unknown',\n  dataset: data.dataset || 'unknown',\n  alerts: Array.isArray(data.alerts) ? data.alerts : [],\n  timestamp: data.timestamp || Date.now() / 1000\n}}];"
      },
      "id": "normalize-alert",
      "name": "Normalize Alert Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [360, 400]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "echo-simulation-complete",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "webhook-complete",
      "name": "Webhook: Simulation Complete",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [200, 800],
      "webhookId": "echo-simulation-complete"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst data = (raw && raw.body && typeof raw.body === 'object') ? raw.body : raw;\nconst regulator = data.regulator || {};\nconst sentiment = data.sentiment_report || {};\nreturn [{ json: {\n  event: data.event || 'simulation_complete',\n  mode: data.mode || 'unknown',\n  dataset: data.dataset || 'unknown',\n  total_rounds: Number(data.total_rounds ?? 0),\n  regulator: {\n    mean_lambda: regulator.mean_lambda ?? null,\n    peak_lambda: regulator.peak_lambda ?? null,\n    total_alerts: regulator.total_alerts ?? 0,\n    trend: regulator.trend || 'n/a',\n    convergence_round: regulator.convergence_round ?? null\n  },\n  sentiment_report: {\n    suspicious_rate: sentiment.suspicious_rate ?? null,\n    intent_drift: sentiment.intent_drift ?? null,\n    mean_cooperative: sentiment.mean_cooperative ?? null\n  },\n  forecast: data.forecast || [],\n  timestamp: data.timestamp || Date.now() / 1000\n}}];"
      },
      "id": "normalize-complete",
      "name": "Normalize Complete Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [360, 800]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.lambda }}",
              "operation": "largerEqual",
              "value2": 0.7
            }
          ]
        }
      },
      "id": "severity-filter",
      "name": "Severity Router",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [560, 400]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.lambda }}",
              "operation": "largerEqual",
              "value2": 0.5
            }
          ]
        }
      },
      "id": "warning-filter",
      "name": "Warning Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [780, 560]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sev",
